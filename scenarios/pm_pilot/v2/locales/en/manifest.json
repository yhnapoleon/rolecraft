        "retrieval_probe_query": {
          "schema_version": 2,
          "mode": "paraphrase_only",
          "actors": [
            "tech_lead"
          ],
          "paraphrase": "A preparation-stage test reproduced this question: I've already signed up for company training. Does that mean I can simply turn up to attend the class? At threshold 0.35 it retrieved no supported passage; at 0.2 it returned the FAQ training-registration paragraph. An unrelated control still retrieved nothing. This is a local comparison, not a generally correct threshold."
        },
        "retrieval_threshold_candidate": {
          "schema_version": 2,
          "mode": "paraphrase_only",
          "actors": [
            "tech_lead"
          ],
          "paraphrase": "A preparation-stage test reproduced this question: I've already signed up for company training. Does that mean I can simply turn up to attend the class? At threshold 0.35 it retrieved no supported passage; at 0.2 it returned the FAQ training-registration paragraph. An unrelated control still retrieved nothing. This is a local comparison, not a generally correct threshold."
        },
        "retrieval_debug_code": {
          "schema_version": 2,
          "mode": "paraphrase_only",
          "actors": [
            "tech_lead"
          ],
          "paraphrase": "The technical diagnostic retains the original training question, two thresholds and an unrelated control. Its internal register ID is not for disclosure."
        }
      },
