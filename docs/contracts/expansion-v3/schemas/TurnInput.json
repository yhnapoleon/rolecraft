        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "text": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "role_id",
    "text"
  ],
  "title": "TurnInput",
  "type": "object"
}
