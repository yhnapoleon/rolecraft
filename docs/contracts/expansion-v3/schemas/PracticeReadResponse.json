{
  "$defs": {
    "JsonValue": {},
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "config_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Version"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "session_id",
        "kind",
        "object_id",
        "version"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "PracticeView": {
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "can_choose_other": {
          "const": true,
          "default": true,
          "title": "Can Choose Other",
          "type": "boolean"
        },
        "can_decline": {
          "const": true,
          "default": true,
          "title": "Can Decline",
          "type": "boolean"
        },
        "catalog": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Catalog",
          "type": "array"
        },
        "learning_gain": {
          "const": "not_established",
          "default": "not_established",
          "title": "Learning Gain",
          "type": "string"
        },
        "links": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Links",
          "type": "array"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "options": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Options",
          "type": "array"
        },
        "source_feedback": {
          "$ref": "#/$defs/ObjectRef"
        },
        "source_feedback_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Feedback Hash",
          "type": "string"
        },
        "suggestion_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Suggestion Hash",
          "type": "string"
        },
        "work_language": {
          "enum": [
            "zh",
            "en"
          ],
          "title": "Work Language",
          "type": "string"
        }
      },
      "required": [
        "source_feedback",
        "source_feedback_hash",
        "suggestion_hash",
        "work_language",
        "options",
        "note",
        "available",
        "catalog",
        "links"
      ],
      "title": "PracticeView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "result": {
      "$ref": "#/$defs/PracticeView"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "result"
  ],
  "title": "PracticeReadResponse",
  "type": "object"
}
