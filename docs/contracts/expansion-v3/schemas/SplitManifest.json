{
  "$defs": {
    "FileRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "FileRef",
      "type": "object"
    },
    "SplitEntry": {
      "additionalProperties": false,
      "properties": {
        "ancestors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Ancestors",
          "type": "array"
        },
        "component_id": {
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "file": {
          "$ref": "#/$defs/FileRef"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "seen_test": {
          "default": false,
          "title": "Seen Test",
          "type": "boolean"
        },
        "split": {
          "enum": [
            "train",
            "dev",
            "test",
            "regression"
          ],
          "title": "Split",
          "type": "string"
        },
        "structure_id": {
          "minLength": 1,
          "title": "Structure Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "structure_id",
        "component_id",
        "split",
        "file"
      ],
      "title": "SplitEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "campaign_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Campaign Id"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/SplitEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "independent_structure_count": {
      "minimum": 0,
      "title": "Independent Structure Count",
      "type": "integer"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "test_opened": {
      "default": false,
      "title": "Test Opened",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "entries",
    "independent_structure_count"
  ],
  "title": "SplitManifest",
  "type": "object"
}
