{
  "$defs": {
    "Command": {
      "additionalProperties": false,
      "properties": {
        "expected_version": {
          "minimum": 0,
          "title": "Expected Version",
          "type": "integer"
        },
        "expected_workspace_revision": {
          "minimum": 0,
          "title": "Expected Workspace Revision",
          "type": "integer"
        },
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "payload": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "default": {},
          "title": "Payload",
          "type": "object"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "expected_version",
        "expected_workspace_revision",
        "operation"
      ],
      "title": "Command",
      "type": "object"
    },
    "Executor": {
      "additionalProperties": false,
      "properties": {
        "delegation_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delegation Id"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "external_agent",
            "reference_agent",
            "system"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Executor",
      "type": "object"
    },
    "JobContextSnapshot": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/Executor"
        },
        "as_of": {
          "$ref": "#/$defs/VersionPoint"
        },
        "conflict_policy": {
          "const": "reject_and_refresh",
          "default": "reject_and_refresh",
          "title": "Conflict Policy",
          "type": "string"
        },
        "context_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Context Hash",
          "type": "string"
        },
        "credential_id": {
          "minLength": 1,
          "title": "Credential Id",
          "type": "string"
        },
        "head_dependencies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Head Dependencies",
          "type": "array"
        },
        "refresh_count": {
          "default": 0,
          "minimum": 0,
          "title": "Refresh Count",
          "type": "integer"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Sources",
          "type": "array"
        },
        "state_dependencies": {
          "default": [],
          "items": {
            "enum": [
              "config_version",
              "resources",
              "applied_milestones",
              "status",
              "cycle_id"
            ],
            "type": "string"
          },
          "title": "State Dependencies",
          "type": "array"
        }
      },
      "required": [
        "session_id",
        "request_id",
        "credential_id",
        "actor",
        "action",
        "as_of",
        "context_hash",
        "sources"
      ],
      "title": "JobContextSnapshot",
      "type": "object"
    },
    "JsonValue": {},
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "config_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Version"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "session_id",
        "kind",
        "object_id",
        "version"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionPoint": {
      "additionalProperties": false,
      "properties": {
        "business_seq": {
          "minimum": 0,
          "title": "Business Seq",
          "type": "integer"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "storage_revision": {
          "minimum": 0,
          "title": "Storage Revision",
          "type": "integer"
        },
        "workspace_revision": {
          "minimum": 0,
          "title": "Workspace Revision",
          "type": "integer"
        }
      },
      "required": [
        "business_seq",
        "workspace_revision",
        "storage_revision"
      ],
      "title": "VersionPoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capability": {
      "default": "act",
      "enum": [
        "read",
        "act",
        "submit",
        "delegate"
      ],
      "title": "Capability",
      "type": "string"
    },
    "command": {
      "$ref": "#/$defs/Command"
    },
    "context": {
      "$ref": "#/$defs/JobContextSnapshot"
    },
    "job_id": {
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "operation": {
      "minLength": 1,
      "title": "Operation",
      "type": "string"
    },
    "origin_request_id": {
      "minLength": 1,
      "title": "Origin Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "origin_request_id",
    "job_id",
    "context",
    "command",
    "operation"
  ],
  "title": "JobEnvelope",
  "type": "object"
}
