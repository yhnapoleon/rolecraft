    "FeedbackReferenceCheck": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "semantic_support": {
          "const": "not_established",
          "default": "not_established",
          "title": "Semantic Support",
          "type": "string"
