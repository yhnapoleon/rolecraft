        "verified_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRefV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "submitted_reference_hash",
        "status"
