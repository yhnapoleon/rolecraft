{
  "$defs": {
    "AssistantConfig": {
      "additionalProperties": false,
      "properties": {
        "chunk_size": {
          "default": 500,
          "exclusiveMinimum": 0,
          "title": "Chunk Size",
          "type": "integer"
        },
        "config_version": {
          "default": 0,
          "minimum": 0,
          "title": "Config Version",
          "type": "integer"
        },
        "domains": {
          "items": {
            "type": "string"
          },
          "title": "Domains",
          "type": "array"
        },
        "fallback": {
          "default": "human",
          "enum": [
            "human",
            "none"
          ],
          "title": "Fallback",
          "type": "string"
        },
        "freshness_guard": {
          "default": "none",
          "enum": [
            "none",
            "warn",
            "fallback"
          ],
          "title": "Freshness Guard",
          "type": "string"
        },
        "generator": {
          "default": "extractive",
          "enum": [
            "extractive",
            "llm"
          ],
          "title": "Generator",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "launch_day": {
          "default": 7,
          "exclusiveMinimum": 0,
          "title": "Launch Day",
          "type": "integer"
        },
        "manual_domains": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Manual Domains",
          "type": "array"
        },
        "min_score": {
          "default": 0.35,
          "minimum": 0,
          "title": "Min Score",
          "type": "number"
        },
        "min_score_calibration": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "participants": {
          "default": 0,
          "minimum": 0,
          "title": "Participants",
          "type": "integer"
        },
        "prohibited_topics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Prohibited Topics",
          "type": "array"
        },
        "retrieval_limit": {
          "default": 3,
          "exclusiveMinimum": 0,
          "title": "Retrieval Limit",
          "type": "integer"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope_filter": {
          "default": true,
          "title": "Scope Filter",
          "type": "boolean"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "update_strategy": {
          "default": "daily",
          "enum": [
            "daily",
            "realtime",
            "manual_policy"
          ],
          "title": "Update Strategy",
          "type": "string"
        },
        "version": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        },
        "work_items": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Work Items",
          "type": "array"
        }
      },
      "required": [
        "id",
        "session_id",
        "domains"
      ],
      "title": "AssistantConfig",
      "type": "object"
    },
    "FileRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "FileRef",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "config_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Version"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "session_id",
        "kind",
        "object_id",
        "version"
      ],
      "title": "ObjectRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "based_on": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "config": {
      "$ref": "#/$defs/AssistantConfig"
    },
    "config_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "mode": {
      "enum": [
        "proposed",
        "applied"
      ],
      "title": "Mode",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "mode",
    "config",
    "content_hash"
  ],
  "title": "BusinessBasis",
  "type": "object"
}
