            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "limit": {
          "minimum": 0,
          "title": "Limit",
          "type": "integer"
        },
        "needed": {
          "minimum": 0,
          "title": "Needed",
          "type": "integer"
        },
        "requested": {
          "minimum": 0,
          "title": "Requested",
          "type": "integer"
        },
        "resource": {
          "minLength": 1,
          "title": "Resource",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "resource",
        "current",
        "requested",
        "limit",
        "needed"
      ],
      "title": "_ApprovalTermCheck",
      "type": "object"
    }
