          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "terms"
      ],
      "title": "_ApprovalAssessment",
      "type": "object"
    },
    "_ApprovalTermCheck": {
      "additionalProperties": false,
      "description": "One requested term beside the allocation, ceiling and need it was judged against.",
      "properties": {
        "current": {
          "minimum": 0,
          "title": "Current",
          "type": "integer"
        },
        "issues": {
          "default": [],
          "items": {
            "enum": [
              "over_limit",
              "below_current",
              "no_increase",
              "no_shortfall",
              "insufficient",
              "need_over_limit"
