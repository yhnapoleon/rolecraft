{
  "$defs": {
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "config_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Version"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "session_id",
        "kind",
        "object_id",
        "version"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ShownPractice": {
      "properties": {
        "source_feedback": {
          "$ref": "#/$defs/ObjectRef"
        },
        "source_feedback_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Feedback Hash",
          "type": "string"
        },
        "suggestion_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Suggestion Hash",
          "type": "string"
        },
        "work_language": {
          "enum": [
            "zh",
            "en"
          ],
          "title": "Work Language",
          "type": "string"
        }
      },
      "required": [
        "source_feedback",
        "source_feedback_hash",
        "suggestion_hash",
        "work_language"
      ],
      "title": "ShownPractice",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "choice": {
      "enum": [
        "choose",
        "choose_other",
        "decline",
        "continue_revision"
      ],
      "title": "Choice",
      "type": "string"
    },
    "option_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Option Id"
    },
    "request_id": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "shown": {
      "$ref": "#/$defs/ShownPractice"
    }
  },
  "required": [
    "request_id",
    "choice",
    "shown"
  ],
  "title": "PracticeChoiceInput",
  "type": "object"
}
