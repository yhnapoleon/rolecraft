{
  "additionalProperties": false,
  "properties": {
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "labels": {
      "items": {
        "type": "string"
      },
      "title": "Labels",
      "type": "array"
    },
    "model_revision": {
      "minLength": 1,
      "title": "Model Revision",
      "type": "string"
    },
    "probabilities": {
      "anyOf": [
        {
          "items": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Probabilities"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "success",
        "unavailable",
        "invalid",
        "timeout"
      ],
      "title": "Status",
      "type": "string"
    },
    "task_type": {
      "enum": [
        "relation",
        "criterion",
        "trajectory_diagnosis",
        "acquisition"
      ],
      "title": "Task Type",
      "type": "string"
    }
  },
  "required": [
    "task_type",
    "input_hash",
    "model_revision",
    "status",
    "labels"
  ],
  "title": "ModelPrediction",
  "type": "object"
}
