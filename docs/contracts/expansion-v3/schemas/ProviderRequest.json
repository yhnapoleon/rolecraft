{
  "$defs": {
    "JsonValue": {},
    "ProviderMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "ProviderMessage",
      "type": "object"
    },
    "ProviderTool": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "description",
        "parameters"
      ],
      "title": "ProviderTool",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "decode": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "default": {},
      "title": "Decode",
      "type": "object"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/ProviderMessage"
      },
      "title": "Messages",
      "type": "array"
    },
    "model_revision": {
      "minLength": 1,
      "title": "Model Revision",
      "type": "string"
    },
    "output_limit": {
      "exclusiveMinimum": 0,
      "title": "Output Limit",
      "type": "integer"
    },
    "prompt_revision": {
      "minLength": 1,
      "title": "Prompt Revision",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "tools": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProviderTool"
      },
      "title": "Tools",
      "type": "array"
    },
    "tools_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Tools Digest",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "attempt_id",
    "provider",
    "model_revision",
    "prompt_revision",
    "messages",
    "tools_digest",
    "deadline",
    "output_limit"
  ],
  "title": "ProviderRequest",
  "type": "object"
}
