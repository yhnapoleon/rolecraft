{
  "$defs": {
    "EvidenceRefV2": {
      "additionalProperties": false,
      "properties": {
        "config_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Version"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "observed_at_seq": {
          "minimum": 0,
          "title": "Observed At Seq",
          "type": "integer"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "span_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span End"
        },
        "span_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Start"
        },
        "valid_from_seq": {
          "default": 0,
          "minimum": 0,
          "title": "Valid From Seq",
          "type": "integer"
        },
        "valid_until_seq": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until Seq"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "session_id",
        "kind",
        "object_id",
        "version",
        "observed_at_seq"
      ],
      "title": "EvidenceRefV2",
      "type": "object"
    },
    "Executor": {
      "additionalProperties": false,
      "properties": {
        "delegation_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delegation Id"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "external_agent",
            "reference_agent",
            "system"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Executor",
      "type": "object"
    },
    "FeedbackActivity": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "counterparty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Counterparty"
        },
        "executor": {
          "$ref": "#/$defs/Executor"
        },
        "kind": {
          "enum": [
            "material_read",
            "test_run",
            "question_sent",
            "reply_received",
            "learner_displayed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "occurred_at": {
          "$ref": "#/$defs/VersionPoint"
        },
        "ref": {
          "$ref": "#/$defs/EvidenceRefV2"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "ref",
        "occurred_at",
        "executor",
        "actor_id"
      ],
      "title": "FeedbackActivity",
      "type": "object"
    },
    "FeedbackActivityCount": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "complete",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "verified_records": {
          "default": 0,
          "minimum": 0,
          "title": "Verified Records",
          "type": "integer"
        }
      },
      "title": "FeedbackActivityCount",
      "type": "object"
    },
    "FeedbackActivityWindow": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "$ref": "#/$defs/VersionPoint"
        },
        "covered_from": {
          "$ref": "#/$defs/VersionPoint"
        },
        "covered_through": {
          "$ref": "#/$defs/VersionPoint"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "covered_from",
        "covered_through",
        "captured_at"
      ],
      "title": "FeedbackActivityWindow",
      "type": "object"
    },
    "FeedbackReferenceCheck": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "semantic_support": {
          "const": "not_established",
          "default": "not_established",
          "title": "Semantic Support",
          "type": "string"
        },
        "status": {
          "enum": [
            "exact_reference_verified",
            "unavailable",
            "future_evidence",
            "evidence_version_mismatch",
            "evidence_quote_mismatch",
            "evidence_time_mismatch",
            "source_time_unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "submitted_reference_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Submitted Reference Hash"
        },
        "valid_at_subject": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid At Subject"
        },
        "verified_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRefV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "submitted_reference_hash",
        "status"
      ],
      "title": "FeedbackReferenceCheck",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "config_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Version"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "session_id",
        "kind",
        "object_id",
        "version"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionPoint": {
      "additionalProperties": false,
      "properties": {
        "business_seq": {
          "minimum": 0,
          "title": "Business Seq",
          "type": "integer"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "storage_revision": {
          "minimum": 0,
          "title": "Storage Revision",
          "type": "integer"
        },
        "workspace_revision": {
          "minimum": 0,
          "title": "Workspace Revision",
          "type": "integer"
        }
      },
      "required": [
        "business_seq",
        "workspace_revision",
        "storage_revision"
      ],
      "title": "VersionPoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activity_records": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FeedbackActivity"
      },
      "title": "Activity Records",
      "type": "array"
    },
    "activity_totals": {
      "additionalProperties": {
        "$ref": "#/$defs/FeedbackActivityCount"
      },
      "default": {},
      "propertyNames": {
        "enum": [
          "material_read",
          "test_run",
          "question_sent",
          "reply_received",
          "learner_displayed"
        ]
      },
      "title": "Activity Totals",
      "type": "object"
    },
    "activity_window": {
      "anyOf": [
        {
          "$ref": "#/$defs/FeedbackActivityWindow"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "actor_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actor Id"
    },
    "adopter": {
      "anyOf": [
        {
          "$ref": "#/$defs/Executor"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "as_of": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionPoint"
        },
        {
          "type": "null"
        }
      ]
    },
    "author": {
      "anyOf": [
        {
          "$ref": "#/$defs/Executor"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "captured_at": {
      "$ref": "#/$defs/VersionPoint"
    },
    "conclusion_quality": {
      "const": "not_scored",
      "default": "not_scored",
      "title": "Conclusion Quality",
      "type": "string"
    },
    "declared_citation_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Declared Citation Count"
    },
    "declared_source_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Declared Source Count"
    },
    "executor": {
      "anyOf": [
        {
          "$ref": "#/$defs/Executor"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "independent_understanding": {
      "const": "unobserved",
      "default": "unobserved",
      "title": "Independent Understanding",
      "type": "string"
    },
    "references": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FeedbackReferenceCheck"
      },
      "title": "References",
      "type": "array"
    },
    "requested_at": {
      "$ref": "#/$defs/VersionPoint"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_snapshot_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Snapshot Hash"
    },
    "status": {
      "enum": [
        "verified",
        "partial",
        "unknown"
      ],
      "title": "Status",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/ObjectRef"
    },
    "summary": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Summary",
      "type": "array"
    },
    "verified_source_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verified Source Count"
    }
  },
  "required": [
    "subject",
    "status",
    "as_of",
    "requested_at",
    "captured_at",
    "source_snapshot_hash"
  ],
  "title": "VerifiedFactsSnapshot",
  "type": "object"
}
