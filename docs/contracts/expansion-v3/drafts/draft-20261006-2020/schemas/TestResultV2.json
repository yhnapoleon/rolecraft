{
  "$defs": {
    "AssistantConfig": {
      "additionalProperties": false,
      "properties": {
        "chunk_size": {
          "default": 500,
          "exclusiveMinimum": 0,
          "title": "Chunk Size",
          "type": "integer"
        },
        "config_version": {
          "default": 0,
          "minimum": 0,
          "title": "Config Version",
          "type": "integer"
        },
        "domains": {
          "items": {
            "type": "string"
          },
          "title": "Domains",
          "type": "array"
        },
        "fallback": {
          "default": "human",
          "enum": [
            "human",
            "none"
          ],
          "title": "Fallback",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "launch_day": {
          "default": 7,
          "exclusiveMinimum": 0,
          "title": "Launch Day",
          "type": "integer"
        },
        "participants": {
          "default": 0,
          "minimum": 0,
          "title": "Participants",
          "type": "integer"
        },
        "prohibited_topics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Prohibited Topics",
          "type": "array"
        },
        "retrieval_limit": {
          "default": 3,
          "exclusiveMinimum": 0,
          "title": "Retrieval Limit",
          "type": "integer"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope_filter": {
          "default": true,
          "title": "Scope Filter",
          "type": "boolean"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "update_strategy": {
          "default": "daily",
          "enum": [
            "daily",
            "realtime",
            "manual_policy"
          ],
          "title": "Update Strategy",
          "type": "string"
        },
        "version": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        },
        "work_items": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Work Items",
          "type": "array"
        }
      },
      "required": [
        "id",
        "session_id",
        "domains"
      ],
      "title": "AssistantConfig",
      "type": "object"
    },
    "EffectiveConfig": {
      "additionalProperties": false,
      "properties": {
        "differences": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Differences",
          "type": "object"
        },
        "effective": {
          "$ref": "#/$defs/AssistantConfig"
        },
        "requested": {
          "$ref": "#/$defs/AssistantConfig"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "requested",
        "effective"
      ],
      "title": "EffectiveConfig",
      "type": "object"
    },
    "EvidenceRefV2": {
      "additionalProperties": false,
      "properties": {
        "config_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Version"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "observed_at_seq": {
          "minimum": 0,
          "title": "Observed At Seq",
          "type": "integer"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "span_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span End"
        },
        "span_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Start"
        },
        "valid_from_seq": {
          "default": 0,
          "minimum": 0,
          "title": "Valid From Seq",
          "type": "integer"
        },
        "valid_until_seq": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until Seq"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "session_id",
        "kind",
        "object_id",
        "version",
        "observed_at_seq"
      ],
      "title": "EvidenceRefV2",
      "type": "object"
    },
    "VersionPoint": {
      "additionalProperties": false,
      "properties": {
        "business_seq": {
          "minimum": 0,
          "title": "Business Seq",
          "type": "integer"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "storage_revision": {
          "minimum": 0,
          "title": "Storage Revision",
          "type": "integer"
        },
        "workspace_revision": {
          "minimum": 0,
          "title": "Workspace Revision",
          "type": "integer"
        }
      },
      "required": [
        "business_seq",
        "workspace_revision",
        "storage_revision"
      ],
      "title": "VersionPoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer": {
      "title": "Answer",
      "type": "string"
    },
    "as_of": {
      "$ref": "#/$defs/VersionPoint"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/EvidenceRefV2"
      },
      "title": "Citations",
      "type": "array"
    },
    "config": {
      "$ref": "#/$defs/EffectiveConfig"
    },
    "declared_category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Declared Category"
    },
    "declared_expected": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Declared Expected"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "observed_coverage": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Observed Coverage",
      "type": "array"
    },
    "query": {
      "title": "Query",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "answered",
        "answered_with_warning",
        "fallback",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "version": {
      "default": 1,
      "exclusiveMinimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "session_id",
    "query",
    "config",
    "status",
    "answer",
    "citations",
    "as_of"
  ],
  "title": "TestResultV2",
  "type": "object"
}
