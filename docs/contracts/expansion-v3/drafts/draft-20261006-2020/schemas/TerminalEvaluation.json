  "additionalProperties": false,
  "properties": {
    "decision": {
      "title": "Decision",
      "type": "string"
    },
    "evaluation": {
      "$ref": "#/$defs/FileRef"
    },
    "outcome": {
      "enum": [
        "satisfied",
        "unsatisfied",
        "undetermined"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "pending_questions": {
      "items": {
        "type": "string"
      },
      "title": "Pending Questions",
      "type": "array"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "subject": {
      "$ref": "#/$defs/ObjectRef"
    },
    "verified_facts": {
      "items": {
        "$ref": "#/$defs/EvidenceRefV2"
      },
      "title": "Verified Facts",
      "type": "array"
    }
  },
  "required": [
    "subject",
    "evaluation",
    "outcome",
    "decision",
    "verified_facts",
    "pending_questions",
    "reason"
