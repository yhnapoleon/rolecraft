{
  "$defs": {
    "ActionProposal": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        },
        "expected_cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/Budget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "tool": {
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "id",
        "tool",
        "arguments",
        "purpose"
      ],
      "title": "ActionProposal",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "minimum": 0,
          "title": "Actions",
          "type": "integer"
        },
        "currency_limit": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency Limit"
        },
        "model_calls": {
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens"
        },
        "wall_seconds": {
          "exclusiveMinimum": 0,
          "title": "Wall Seconds",
          "type": "number"
        }
      },
      "required": [
        "model_calls",
        "actions",
        "wall_seconds"
      ],
      "title": "Budget",
      "type": "object"
    },
    "FileRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "FileRef",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "applicable_structures": {
      "items": {
        "type": "string"
      },
      "title": "Applicable Structures",
      "type": "array"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "counterexamples": {
      "items": {
        "type": "string"
      },
      "title": "Counterexamples",
      "type": "array"
    },
    "failure_conditions": {
      "items": {
        "type": "string"
      },
      "title": "Failure Conditions",
      "type": "array"
    },
    "goal": {
      "title": "Goal",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "postconditions": {
      "items": {
        "type": "string"
      },
      "title": "Postconditions",
      "type": "array"
    },
    "preconditions": {
      "items": {
        "type": "string"
      },
      "title": "Preconditions",
      "type": "array"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_splits": {
      "items": {
        "enum": [
          "train",
          "dev"
        ],
        "type": "string"
      },
      "title": "Source Splits",
      "type": "array"
    },
    "source_trajectories": {
      "items": {
        "$ref": "#/$defs/FileRef"
      },
      "title": "Source Trajectories",
      "type": "array"
    },
    "status": {
      "enum": [
        "candidate",
        "validated",
        "deprecated"
      ],
      "title": "Status",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/ActionProposal"
      },
      "title": "Steps",
      "type": "array"
    },
    "tool_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Tool Versions",
      "type": "object"
    },
    "validation_records": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FileRef"
      },
      "title": "Validation Records",
      "type": "array"
    },
    "version": {
      "exclusiveMinimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "version",
    "goal",
    "preconditions",
    "postconditions",
    "steps",
    "failure_conditions",
    "source_trajectories",
    "source_splits",
    "applicable_structures",
    "counterexamples",
    "tool_versions",
    "status",
    "content_hash"
  ],
  "title": "SkillSpec",
  "type": "object"
}
