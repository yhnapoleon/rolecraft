{
  "$defs": {
    "AnnotationDecision": {
      "additionalProperties": false,
      "properties": {
        "acceptable_evidence_sets": {
          "default": [],
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Acceptable Evidence Sets",
          "type": "array"
        },
        "applicability": {
          "default": "undetermined",
          "enum": [
            "applicable",
            "not_applicable",
            "undetermined"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "evidence_evaluable": {
          "title": "Evidence Evaluable",
          "type": "boolean"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "missing_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "task_type": {
          "enum": [
            "relation",
            "criterion",
            "trajectory_diagnosis",
            "acquisition"
          ],
          "title": "Task Type",
          "type": "string"
        }
      },
      "required": [
        "task_type",
        "label",
        "evidence_evaluable"
      ],
      "title": "AnnotationDecision",
      "type": "object"
    },
    "AnnotationPass": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnnotationDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_order": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Order",
          "type": "array"
        },
        "executor": {
          "$ref": "#/$defs/Executor"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "prompt_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Revision"
        },
        "raw_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Output"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "pending",
            "success",
            "failed",
            "empty"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "executor",
        "status",
        "input_hash"
      ],
      "title": "AnnotationPass",
      "type": "object"
    },
    "Executor": {
      "additionalProperties": false,
      "properties": {
        "delegation_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delegation Id"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "external_agent",
            "reference_agent",
            "system"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Executor",
      "type": "object"
    },
    "FileRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "FileRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adjudication_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/FileRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "annotation_version": {
      "minLength": 1,
      "title": "Annotation Version",
      "type": "string"
    },
    "final": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnnotationDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "label_tier": {
      "enum": [
        "G0",
        "G1",
        "G2",
        "G2v"
      ],
      "title": "Label Tier",
      "type": "string"
    },
    "passes": {
      "items": {
        "$ref": "#/$defs/AnnotationPass"
      },
      "title": "Passes",
      "type": "array"
    },
    "record_id": {
      "minLength": 1,
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "pending",
        "accepted",
        "disputed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "verifier_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verifier Id"
    }
  },
  "required": [
    "record_id",
    "annotation_version",
    "input_hash",
    "label_tier",
    "status",
    "passes"
  ],
  "title": "AnnotationV2",
  "type": "object"
}
