{
  "$defs": {
    "ImportReference": {
      "additionalProperties": false,
      "properties": {
        "original_id": {
          "minLength": 1,
          "title": "Original Id",
          "type": "string"
        },
        "original_session_id": {
          "minLength": 1,
          "title": "Original Session Id",
          "type": "string"
        },
        "resolved": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "resolved",
            "missing",
            "foreign_session",
            "unverified_local"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "original_id",
        "original_session_id",
        "status"
      ],
      "title": "ImportReference",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "config_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Version"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "session_id",
        "kind",
        "object_id",
        "version"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionPoint": {
      "additionalProperties": false,
      "properties": {
        "business_seq": {
          "minimum": 0,
          "title": "Business Seq",
          "type": "integer"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "storage_revision": {
          "minimum": 0,
          "title": "Storage Revision",
          "type": "integer"
        },
        "workspace_revision": {
          "minimum": 0,
          "title": "Workspace Revision",
          "type": "integer"
        }
      },
      "required": [
        "business_seq",
        "workspace_revision",
        "storage_revision"
      ],
      "title": "VersionPoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "applied": {
      "title": "Applied",
      "type": "boolean"
    },
    "as_of": {
      "$ref": "#/$defs/VersionPoint"
    },
    "id_map": {
      "additionalProperties": {
        "$ref": "#/$defs/ObjectRef"
      },
      "title": "Id Map",
      "type": "object"
    },
    "mode": {
      "enum": [
        "preview",
        "apply"
      ],
      "title": "Mode",
      "type": "string"
    },
    "package_id": {
      "minLength": 1,
      "title": "Package Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "unresolved": {
      "items": {
        "$ref": "#/$defs/ImportReference"
      },
      "title": "Unresolved",
      "type": "array"
    }
  },
  "required": [
    "package_id",
    "mode",
    "id_map",
    "unresolved",
    "as_of",
    "applied"
  ],
  "title": "ImportResult",
  "type": "object"
}
