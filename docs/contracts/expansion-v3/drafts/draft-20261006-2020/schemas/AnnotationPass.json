{
  "$defs": {
    "AnnotationDecision": {
      "additionalProperties": false,
      "properties": {
        "acceptable_evidence_sets": {
          "default": [],
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Acceptable Evidence Sets",
          "type": "array"
        },
        "applicability": {
          "default": "undetermined",
          "enum": [
            "applicable",
            "not_applicable",
            "undetermined"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "evidence_evaluable": {
          "title": "Evidence Evaluable",
          "type": "boolean"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "missing_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "task_type": {
          "enum": [
            "relation",
            "criterion",
            "trajectory_diagnosis",
            "acquisition"
          ],
          "title": "Task Type",
          "type": "string"
        }
      },
      "required": [
        "task_type",
        "label",
        "evidence_evaluable"
      ],
      "title": "AnnotationDecision",
      "type": "object"
    },
    "Executor": {
      "additionalProperties": false,
      "properties": {
        "delegation_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delegation Id"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "external_agent",
            "reference_agent",
            "system"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Executor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnnotationDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence_order": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Order",
      "type": "array"
    },
    "executor": {
      "$ref": "#/$defs/Executor"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "model_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Revision"
    },
    "prompt_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Revision"
    },
    "raw_output": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Output"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "pending",
        "success",
        "failed",
        "empty"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "id",
    "executor",
    "status",
    "input_hash"
  ],
  "title": "AnnotationPass",
  "type": "object"
}
