{
  "$defs": {
    "Executor": {
      "additionalProperties": false,
      "properties": {
        "delegation_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delegation Id"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "external_agent",
            "reference_agent",
            "system"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Executor",
      "type": "object"
    },
    "FileRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "FileRef",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "config_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Version"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "session_id",
        "kind",
        "object_id",
        "version"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "VersionPoint": {
      "additionalProperties": false,
      "properties": {
        "business_seq": {
          "minimum": 0,
          "title": "Business Seq",
          "type": "integer"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "storage_revision": {
          "minimum": 0,
          "title": "Storage Revision",
          "type": "integer"
        },
        "workspace_revision": {
          "minimum": 0,
          "title": "Workspace Revision",
          "type": "integer"
        }
      },
      "required": [
        "business_seq",
        "workspace_revision",
        "storage_revision"
      ],
      "title": "VersionPoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "$ref": "#/$defs/VersionPoint"
    },
    "evaluation": {
      "$ref": "#/$defs/FileRef"
    },
    "executor": {
      "$ref": "#/$defs/Executor"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "purpose": {
      "title": "Purpose",
      "type": "string"
    },
    "question": {
      "default": "",
      "title": "Question",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "items": {
        "type": "string"
      },
      "title": "Scope",
      "type": "array"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "subjects": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "minItems": 1,
      "title": "Subjects",
      "type": "array"
    },
    "version": {
      "default": 1,
      "exclusiveMinimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "session_id",
    "subjects",
    "purpose",
    "as_of",
    "scope",
    "evaluation",
    "executor"
  ],
  "title": "ReviewRequest",
  "type": "object"
}
