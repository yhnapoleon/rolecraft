{
  "$defs": {
    "ImportReference": {
      "additionalProperties": false,
      "properties": {
        "original_id": {
          "minLength": 1,
          "title": "Original Id",
          "type": "string"
        },
        "original_session_id": {
          "minLength": 1,
          "title": "Original Session Id",
          "type": "string"
        },
        "resolved": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "resolved",
            "missing",
            "foreign_session",
            "unverified_local"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "original_id",
        "original_session_id",
        "status"
      ],
      "title": "ImportReference",
      "type": "object"
    },
    "JsonValue": {},
    "LegacyProvenance": {
      "additionalProperties": false,
      "properties": {
        "original_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Original Hash",
          "type": "string"
        },
        "original_id": {
          "minLength": 1,
          "title": "Original Id",
          "type": "string"
        },
        "original_kind": {
          "title": "Original Kind",
          "type": "string"
        },
        "original_purpose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Purpose"
        },
        "raw": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Raw",
          "type": "object"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_schema": {
          "minLength": 1,
          "title": "Source Schema",
          "type": "string"
        },
        "source_session_id": {
          "minLength": 1,
          "title": "Source Session Id",
          "type": "string"
        }
      },
      "required": [
        "source_schema",
        "source_session_id",
        "original_id",
        "original_kind",
        "raw",
        "original_hash"
      ],
      "title": "LegacyProvenance",
      "type": "object"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "config_version": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Version"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "minLength": 1,
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "version": {
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "session_id",
        "kind",
        "object_id",
        "version"
      ],
      "title": "ObjectRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/LegacyProvenance"
      },
      "title": "Items",
      "type": "array"
    },
    "mode": {
      "enum": [
        "preview",
        "apply"
      ],
      "title": "Mode",
      "type": "string"
    },
    "package_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Package Hash",
      "type": "string"
    },
    "package_id": {
      "minLength": 1,
      "title": "Package Id",
      "type": "string"
    },
    "preview_storage_revision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preview Storage Revision"
    },
    "references": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ImportReference"
      },
      "title": "References",
      "type": "array"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_schema": {
      "minLength": 1,
      "title": "Source Schema",
      "type": "string"
    },
    "source_session_id": {
      "minLength": 1,
      "title": "Source Session Id",
      "type": "string"
    }
  },
  "required": [
    "package_id",
    "mode",
    "source_schema",
    "source_session_id",
    "items",
    "package_hash"
  ],
  "title": "WorkspaceImport",
  "type": "object"
}
