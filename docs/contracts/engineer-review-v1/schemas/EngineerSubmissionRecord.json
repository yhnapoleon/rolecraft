            "minLength": 1,
            "type": "string"
          },
          "title": "Probe Ids",
          "type": "array"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "visibility": {
