          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "EngineerUnresolvedItem",
      "type": "object"
    },
    "Executor": {
      "additionalProperties": false,
      "properties": {
