  "additionalProperties": false,
  "properties": {
    "actual": {
      "anyOf": [
        {
          "$ref": "#/$defs/TestResultV2"
        },
        {
          "type": "null"
        }
      ]
    },
    "config_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Hash",
      "type": "string"
    },
    "elapsed_seconds": {
      "minimum": 0,
      "title": "Elapsed Seconds",
      "type": "number"
    },
    "error_code": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "expected": {
      "$ref": "#/$defs/EngineerProbeExpectation"
    },
    "probe_id": {
      "minLength": 1,
      "title": "Probe Id",
      "type": "string"
    },
    "query": {
      "title": "Query",
      "type": "string"
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "error"
      ],
      "title": "Result",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
