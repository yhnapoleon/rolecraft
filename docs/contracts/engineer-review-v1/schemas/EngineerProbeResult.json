            "$ref": "#/$defs/ModelAttemptUsage"
          },
          "title": "Attempts",
          "type": "array"
        },
        "chunks": {
          "items": {
            "$ref": "#/$defs/RetrievedChunk"
          },
          "title": "Chunks",
          "type": "array"
        },
        "cost_complete": {
          "default": false,
          "title": "Cost Complete",
          "type": "boolean"
        },
        "executed_at": {
          "format": "date-time",
          "title": "Executed At",
          "type": "string"
        },
        "executor": {
          "$ref": "#/$defs/Executor"
        },
        "indexed_versions": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "title": "Indexed Versions",
          "type": "object"
        },
        "projection_actor": {
          "minLength": 1,
          "title": "Projection Actor",
          "type": "string"
