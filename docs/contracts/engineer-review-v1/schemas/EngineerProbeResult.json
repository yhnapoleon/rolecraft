          "default": null,
          "title": "Error Code"
        },
        "execution": {
          "$ref": "#/$defs/TestExecutionMetadata"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "observed_coverage": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Observed Coverage",
          "type": "array"
        },
        "query": {
          "title": "Query",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "answered",
            "answered_with_warning",
            "fallback",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "session_id",
        "query",
        "execution",
        "config_ref",
        "config",
        "status",
        "answer",
        "citations",
        "as_of"
