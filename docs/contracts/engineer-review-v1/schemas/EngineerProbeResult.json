        "source_versions": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "title": "Source Versions",
          "type": "object"
        },
        "used_versions": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "integer"
          },
          "title": "Used Versions",
          "type": "object"
        }
