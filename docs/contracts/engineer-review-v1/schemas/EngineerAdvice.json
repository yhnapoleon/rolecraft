{
  "$defs": {
    "FileRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "FileRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "affects_score": {
      "const": false,
      "default": false,
      "title": "Affects Score",
      "type": "boolean"
    },
    "model": {
      "anyOf": [
        {
          "$ref": "#/$defs/FileRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "waiting_model",
        "success",
        "unavailable",
        "invalid",
        "timeout"
      ],
      "title": "Status",
      "type": "string"
    },
    "text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Text"
    },
    "visibility": {
      "default": "hidden",
      "enum": [
        "public",
        "hidden"
      ],
      "title": "Visibility",
      "type": "string"
    }
  },
  "required": [
    "status",
    "text",
    "model"
  ],
  "title": "EngineerAdvice",
  "type": "object"
}
