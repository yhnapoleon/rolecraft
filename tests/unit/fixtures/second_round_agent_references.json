          "span_start": null,
          "span_end": null,
          "quote": null,
          "observed_at_seq": 10,
          "valid_from_seq": 0,
          "valid_until_seq": null
        },
        "text": "I recommend deferring the pilot until the launch conditions are verified.\nThe current policy states a hotel reimbursement cap of CNY 400 per person per night.\nEmployees must obtain written manager approval before travelling if the hotel cost exceeds the cap, and keep the receipts.\nI propose starting with 10 users and keeping human fallback for questions outside the supported scope.\nThe policy-update owner and the acceptance criteria still need confirmation.",
        "created_at": {
          "schema_version": 2,
          "business_seq": 10,
          "workspace_revision": 22,
          "storage_revision": 30
        }
      }
    ]
